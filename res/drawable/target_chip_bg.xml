<?xml version="1.0" encoding="utf-8"?>
<!-- Value field / chip: slate fill, thin outline; accent outline when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/row_pressed" />
            <stroke android:width="2dp" android:color="@color/brand" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_highlight" />
            <stroke android:width="2dp" android:color="@color/brand" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_field" />
            <stroke android:width="1dp" android:color="@color/stroke_field" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
