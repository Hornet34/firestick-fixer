<?xml version="1.0" encoding="utf-8"?>
<!--
    Canonical color palette (FireStick Fixer "graphite + Fire orange"). Colors.java mirrors
    the values the Java-built UI needs; keep both in sync. Drawables and the AppTheme
    reference these names directly.
-->
<resources>
    <!-- Accent: switches, focus outlines, highlights. -->
    <color name="brand">#FFFF8A00</color>
    <color name="brand_dark">#FFCC6E00</color>
    <!-- Second accent for the logo's "fix" bolt and warnings. -->
    <color name="amber">#FFFBBF24</color>
    <!-- Translucent accent for focused rows and ripples. -->
    <color name="brand_highlight">#33FF8A00</color>
    <color name="row_pressed">#55FF8A00</color>

    <color name="bg_window">#FF111317</color>
    <color name="bg_bar">#FF17191E</color>
    <color name="bg_card">#FF1C1F26</color>
    <color name="bg_field">#FF262A33</color>
    <color name="stroke_field">#FF3A3F4B</color>
    <color name="surface_tip_box">#FF17191E</color>

    <color name="text_neutral">#FFE5E7EB</color>
    <color name="text_dim">#FF9CA3AF</color>
    <color name="text_white">#FFFFFFFF</color>

    <color name="info_btn_idle">#FF262A33</color>
    <color name="info_btn_pressed">#FFCC6E00</color>
    <color name="info_btn_focused">#FFFF8A00</color>
    <!-- "All good" status (precise detection active, updates blocked). -->
    <color name="ok_green">#FF4ADE80</color>
</resources>
