<?xml version="1.0" encoding="utf-8"?>
<!--
    Canonical color palette (FireStick Fixer "midnight + teal"). Colors.java mirrors
    the values the Java-built UI needs; keep both in sync. Drawables and the AppTheme
    reference these names directly.
-->
<resources>
    <!-- Accent: switches, focus outlines, highlights. -->
    <color name="brand">#FF2DD4BF</color>
    <color name="brand_dark">#FF0F766E</color>
    <!-- Second accent for the logo's "fix" bolt and warnings. -->
    <color name="amber">#FFF59E0B</color>
    <!-- Translucent accent for focused rows and ripples. -->
    <color name="brand_highlight">#332DD4BF</color>
    <color name="row_pressed">#552DD4BF</color>

    <color name="bg_window">#FF0B1220</color>
    <color name="bg_bar">#FF0F172A</color>
    <color name="bg_card">#FF141D2F</color>
    <color name="bg_field">#FF1E293B</color>
    <color name="stroke_field">#FF334155</color>
    <color name="surface_tip_box">#FF0F172A</color>

    <color name="text_neutral">#FFCBD5E1</color>
    <color name="text_dim">#FF94A3B8</color>
    <color name="text_white">#FFFFFFFF</color>

    <color name="info_btn_idle">#FF1E293B</color>
    <color name="info_btn_pressed">#FF0F766E</color>
    <color name="info_btn_focused">#FF2DD4BF</color>
</resources>
