<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- App theme: Material dark, teal accent for switches and focus, navy window. -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:colorControlActivated">@color/brand</item>
        <item name="android:colorControlHighlight">@color/brand_highlight</item>
        <item name="android:windowBackground">@color/bg_window</item>
        <item name="android:colorBackground">@color/bg_window</item>
        <item name="android:statusBarColor">@color/bg_bar</item>
    </style>

    <!-- Dialogs (pickers, info, warnings) share the accent and a navy surface. -->
    <style name="AppDialogTheme" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:colorControlActivated">@color/brand</item>
        <item name="android:colorControlHighlight">@color/brand_highlight</item>
        <item name="android:colorBackground">@color/bg_card</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.55</item>
    </style>
</resources>
